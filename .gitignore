# Private Frivo data — never publish these files.
# When Frivo runs from this folder, it keeps its data next to app.py.
config.json
profiles.json
usage.json
launcher.json
server.log
*.log
# CHANGED (1.5.0): the rest of Frivo's data, anywhere in the repo
voice_anchors.json
tag_taste.json
app/audio_cache/
app/saved/
app/anchors/
app/voice_library/
# NEW (1.6.0): the built-in AI's engine and models (gigabytes)
app/builtin_ai/
*.gguf
# Backups made from Settings > Updates hold your settings and replies.
Frivo backup*.zip

# Environment variables and credentials.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
ca.crt
ca.key

# Local Python and build artifacts.
# Generated by Build-Installer.ps1 from the VERSION file — never edited by
# hand, and committing it would put a second copy of the version in the repo.
build/Version.generated.cs
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
dist/
build/FrivoHost.exe

# Written by tests/test-update-ui.py for looking at, not for keeping.
tests/screenshots/
# NEW (1.5.0): output of tests/check-windows-voices.bat
tests/windows-voice-check/

# NEW (1.5.0): voices. Setup downloads Frivo's own (app/voice_pack.py), and
# voices you add or download from the library live here too. Never committed.
app/voices/
*.onnx
*.onnx.json
*.tar.bz2

# NEW (2.0.0): the Frivo app's packages and builds (desktop\). npm ci and
# Build-App.bat make them again from package-lock.json.
desktop/node_modules/
desktop/dist/
# The copy of Node.js Build-App.bat downloads to build the app.
desktop/.tools/
# NEW (2.0.0): the app's installer, put there by Build.bat for FrivoSetup.exe to carry
build/app/
# The app's test certificates: public certificates only, no private keys
# (desktop/test/fixtures/README.md). Kept, despite *.pem above.
!desktop/test/fixtures/*.pem

# NEW (1.5.0): files set aside for deleting by hand; never committed
_to_delete/

# Editor and operating-system files.
.vscode/
.vs/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# NEW (2.0.0): the dictation speed test's output
tools/dictation-bench/results.txt

# NEW (2.0.0): written by Build.bat
desktop/src/build-id.json
